{
  "name": "@powerduck/conf-patch",
  "version": "0.3.5",
  "description": "Two-layer configuration editor: pure core for patching JSON/JSONC/YAML strings (browser-safe), plus file layer with atomic writes and locking for Node.js/Electron. RFC 6902 JSON Patch, comment and formatting preservation, OpenAPI validation.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "demo": "ts-node demo/demo.ts",
    "demo:openapi": "ts-node demo/openapi-demo.ts",
    "reset-fixtures": "ts-node demo/reset-fixtures.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@powerduck/openapi-parser": "^0.3.5",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "openapi-types": "^12.1.3",
    "terser": "^5.51.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "yaml",
    "json",
    "jsonc",
    "config",
    "rfc6902",
    "config-editor",
    "comment-preserve",
    "atomic-write",
    "electron"
  ],
  "author": "POWERDUCK LIMITED",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerducklab/conf-patch.git"
  },
  "bugs": {
    "url": "https://github.com/powerducklab/conf-patch/issues"
  },
  "homepage": "https://www.powerduck.com/"
}
